# GENERATED by scripts/quadlet.sh from docker/compose.yml with podlet 0.3.2.
# Do not edit by hand: change the compose file, run
# `scripts/quadlet.sh generate`, and commit the result.

[Container]
Environment=POSTGRES_USER=openplate
Environment=POSTGRES_PASSWORD=openplate
Environment=POSTGRES_DB=openplate_sync
ExposeHostPort=5432
HealthCmd=pg_isready -U openplate -d openplate_sync
HealthInterval=5s
HealthRetries=10
HealthTimeout=5s
Notify=healthy
Image=postgres:17-alpine
Network=openplate-core.network
Volume=postgres-data:/var/lib/postgresql/data

[Service]
Restart=always

[Install]
WantedBy=default.target
