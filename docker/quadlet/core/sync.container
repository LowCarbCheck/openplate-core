# Do not edit by hand: change the compose file, run
# `scripts/quadlet.sh generate`, and commit the result.

[Unit]
Requires=postgres.service
After=postgres.service

[Container]
Environment=PORT=3000
Environment=DATABASE_URL=postgres://openplate:openplate@postgres:5432/openplate_sync
Environment=INSTANCE_NAME=openplate
Environment=INSTANCE_LANGUAGE=en
Environment=NUTRIENT_REFERENCE_BASIS=dge
Environment=SERVER_PUBLIC_URL=
Environment=CLIENT_BASE_URL=
Environment=TRUST_PROXY=0
Environment=LOG_LEVEL=info
Environment=ADMIN_TOKEN=
Environment=SYNC_SHARING=false
Environment=SYNC_RESEARCH=false
Environment=SYNC_FEEDBACK=false
Environment=FEEDBACK_DAILY_LIMIT=5
Environment=FEEDBACK_MAX_REQUEST_BYTES=8000000
Environment=SYNC_NOTICE=
Environment=SYNC_NOTICE_URL=
Environment=MAIL_API_URL=
Environment=MAIL_API_KEY=
Environment=MAIL_API_FROM=
Environment=MAIL_OPERATOR_EMAIL=
Environment=UPSTREAM_BASE_URL=
Environment=UPSTREAM_API_KEY=
Environment=UPSTREAM_TIMEOUT_MS=120000
Environment=AI_ADVERTISED_MODEL=
Environment=AI_RATE_LIMIT_PER_MINUTE=20
Environment=AI_MAX_REQUEST_BYTES=8000000
Environment=AI_INSTANCE_DAILY_LIMIT=
Environment=MEMBER_INVITE_DAILY_AI_LIMIT=
Environment=MEMBER_INVITE_ALLOWANCE_DAYS=
Environment=MEMBER_INVITE_LIFETIME_CAP=
Environment=OPEN_SIGNUP=
Environment=TURNSTILE_SECRET_KEY=
Environment=TURNSTILE_SITE_KEY=
Environment=VAPID_PUBLIC_KEY=
Environment=VAPID_PRIVATE_KEY=
Environment=VAPID_SUBJECT=
Environment=PLANS_UPSTREAM_URL=
Environment=PLANS_UPSTREAM_SECRET=
Environment=BILLING_TOKEN=
Environment=DATABASE_SSL=false
EnvironmentFile=openplate-core.env
HealthCmd=["node","-e","fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s
HealthTimeout=5s
Notify=healthy
Image=ghcr.io/lowcarbcheck/openplate-core:latest
Network=openplate-core.network:alias=sync
PublishPort=3000:3000

[Service]
TimeoutStartSec=300
Restart=always

[Install]
WantedBy=default.target
